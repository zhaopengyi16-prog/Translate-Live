<UserControl
    x:Class="LiveCaptionsTranslator.controls.TranscriptTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:LiveCaptionsTranslator.models"
    d:DesignHeight="620"
    d:DesignWidth="900"
    FontFamily="{DynamicResource LectureUiFontFamily}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TimelineListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource LectureSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox
            x:Name="TimelineList"
            AutomationProperties.AutomationId="TranscriptTimelineList"
            Grid.Row="0"
            Padding="6,0,12,8"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Segments}"
            ItemContainerStyle="{StaticResource TimelineListItemStyle}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.ScrollChanged="TimelineScrollViewer_ScrollChanged"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="0,18,0,20"
                        Background="Transparent"
                        BorderBrush="{DynamicResource LectureDividerBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="StateMarker"
                                Width="2"
                                Margin="0,0,2,0"
                                HorizontalAlignment="Left"
                                Background="Transparent" />

                            <TextBlock
                                Grid.Column="1"
                                Margin="12,3,18,0"
                                VerticalAlignment="Top"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="11.5"
                                Foreground="{DynamicResource LectureTextTertiaryBrush}"
                                Text="{Binding CapturedTime}" />

                            <StackPanel Grid.Column="2" Margin="0,0,24,0">
                                <TextBlock
                                    FontFamily="{DynamicResource LectureUiFontFamily}"
                                    FontSize="{DynamicResource LectureSourceFontSize}"
                                    Foreground="{DynamicResource LectureTextSecondaryBrush}"
                                    LineHeight="23"
                                    Text="{Binding SourceText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="TranslationText"
                                    Margin="0,6,0,0"
                                    FontFamily="{DynamicResource LectureUiFontFamily}"
                                    FontSize="{DynamicResource LectureSubtitleFontSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource LectureTextPrimaryBrush}"
                                    LineStackingStrategy="BlockLineHeight"
                                    Text="{Binding TranslatedText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="FailureText"
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource LectureErrorBrush}"
                                    Text="翻译失败 · 原文已保留，可在网络恢复后继续"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:SegmentState.Committed}">
                            <Setter TargetName="TranslationText" Property="Foreground" Value="{DynamicResource LectureTextTertiaryBrush}" />
                            <Setter TargetName="TranslationText" Property="FontWeight" Value="Normal" />
                            <Setter TargetName="TranslationText" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:SegmentState.Queued}">
                            <Setter TargetName="TranslationText" Property="Foreground" Value="{DynamicResource LectureTextTertiaryBrush}" />
                            <Setter TargetName="TranslationText" Property="FontWeight" Value="Normal" />
                            <Setter TargetName="TranslationText" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:SegmentState.Translating}">
                            <Setter TargetName="TranslationText" Property="Foreground" Value="{DynamicResource LectureTextTertiaryBrush}" />
                            <Setter TargetName="TranslationText" Property="FontWeight" Value="Normal" />
                            <Setter TargetName="TranslationText" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:SegmentState.TranslationFailed}">
                            <Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource LectureErrorBrush}" />
                            <Setter TargetName="TranslationText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FailureText" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border
            Grid.Row="0"
            MaxWidth="520"
            Margin="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            IsHitTestVisible="False"
            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource LectureTextPrimaryBrush}"
                    Text="{Binding SessionStatus}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource LectureTextTertiaryBrush}"
                    Text="{Binding MicrophoneStatus}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Button
            Grid.Row="0"
            Margin="0,0,34,20"
            Padding="16,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="ReturnToLiveButton"
            Click="ReturnToLive_Click"
            Content="{Binding ReturnToLiveText}"
            Style="{StaticResource LecturePrimaryButtonStyle}"
            Visibility="{Binding IsReturnToLiveVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border
            Grid.Row="1"
            Margin="102,8,28,4"
            Padding="0,13,0,4"
            BorderBrush="{DynamicResource LectureDividerBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding HasDraft, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    FontFamily="Segoe UI"
                    FontSize="14"
                    Foreground="{DynamicResource LectureTextSecondaryBrush}"
                    Text="•••" />
                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{DynamicResource LectureTextTertiaryBrush}"
                        Text="正在聆听" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontFamily="{DynamicResource LectureUiFontFamily}"
                        FontSize="{DynamicResource LectureSourceFontSize}"
                        Foreground="{DynamicResource LectureTextSecondaryBrush}"
                        Text="{Binding DraftText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontFamily="{DynamicResource LectureUiFontFamily}"
                        FontSize="{DynamicResource LectureSubtitleFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource LectureTextPrimaryBrush}"
                        Text="{Binding DraftTranslation}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasDraftTranslation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
