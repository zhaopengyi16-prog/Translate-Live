<Page
    x:Class="LiveCaptionsTranslator.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="旧版字幕"
    Background="{DynamicResource LectureSurfaceBrush}"
    FontFamily="{DynamicResource LectureUiFontFamily}"
    Foreground="{DynamicResource LectureTextPrimaryBrush}"
    JournalEntry.KeepAlive="True"
    mc:Ignorable="d">

    <Grid Margin="30,22,30,22">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="OriginalCaption_Row" Height="Auto" />
            <RowDefinition x:Name="TranslatedCaption_Row" Height="Auto" />
            <RowDefinition x:Name="CaptionLogCard_Row" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="CaptionBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource LectureUiFontFamily}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <Border Grid.Row="0" Padding="0,8,0,14" BorderBrush="{DynamicResource LectureDividerBrush}" BorderThickness="0,0,0,1">
            <TextBlock
                x:Name="OriginalCaption"
                Background="Transparent"
                Cursor="Hand"
                FontSize="{DynamicResource LectureSourceFontSize}"
                Foreground="{DynamicResource LectureTextSecondaryBrush}"
                MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                Style="{StaticResource CaptionBlockStyle}"
                Text="{Binding DisplayOriginalCaption, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="点击复制" />
        </Border>

        <Border Grid.Row="1" MinHeight="52" Padding="0,14,0,16" BorderBrush="{DynamicResource LectureDividerBrush}" BorderThickness="0,0,0,1">
            <TextBlock
                x:Name="TranslatedCaption"
                Background="Transparent"
                Cursor="Hand"
                FontSize="{DynamicResource LectureSubtitleFontSize}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource LectureTextPrimaryBrush}"
                MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                Style="{StaticResource CaptionBlockStyle}"
                Text="{Binding DisplayTranslatedCaption, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="点击复制" />
        </Border>

        <Border x:Name="LogCards" Grid.Row="2" Padding="0,12,0,0" Background="Transparent">
            <ItemsControl
                x:Name="LogCardItems"
                MinHeight="50"
                ItemsSource="{Binding DisplayLogCards, UpdateSourceTrigger=PropertyChanged}"
                VirtualizingPanel.IsVirtualizing="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,12,0,14" BorderBrush="{DynamicResource LectureDividerBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock
                                    x:Name="OriginalCaptionLog"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    FontFamily="{DynamicResource LectureUiFontFamily}"
                                    FontSize="12"
                                    Foreground="{DynamicResource LectureTextSecondaryBrush}"
                                    MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                    Text="{Binding SourceText}"
                                    TextWrapping="Wrap"
                                    ToolTip="点击复制" />
                                <TextBlock
                                    x:Name="TranslatedCaptionLog"
                                    Margin="0,5,0,0"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    FontFamily="{DynamicResource LectureUiFontFamily}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource LectureTextPrimaryBrush}"
                                    MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                    Text="{Binding TranslatedText}"
                                    TextWrapping="Wrap"
                                    ToolTip="点击复制" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Page>
