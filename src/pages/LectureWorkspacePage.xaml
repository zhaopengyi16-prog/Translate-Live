<Page
    x:Class="LiveCaptionsTranslator.LectureWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LiveCaptionsTranslator.controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="课堂工作台"
    Background="{DynamicResource LectureWindowBrush}"
    FontFamily="{DynamicResource LectureUiFontFamily}"
    Foreground="{DynamicResource LectureTextPrimaryBrush}"
    HorizontalAlignment="Stretch"
    JournalEntry.KeepAlive="True"
    PreviewKeyDown="Page_PreviewKeyDown"
    UseLayoutRounding="True"
    VerticalAlignment="Stretch"
    mc:Ignorable="d"
    d:DesignHeight="760"
    d:DesignWidth="1180">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="WorkspaceTabStyle" TargetType="Button">
            <Setter Property="Height" Value="62" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,38,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource LectureTextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource LectureUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="TabChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource LectureTextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource LectureButtonStyle}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource LectureWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="课堂" />
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource LectureTextTertiaryBrush}"
                    Text="/" />
                <TextBlock
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource LectureTextPrimaryBrush}"
                    Text="{Binding CaptureMode}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Ellipse
                    Width="8"
                    Height="8"
                    Margin="0,0,8,0"
                    Fill="{DynamicResource LectureTextTertiaryBrush}" />
                <TextBlock
                    MaxWidth="210"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource LectureTextSecondaryBrush}"
                    Text="{Binding LiveCaptionsStatus}"
                    TextTrimming="CharacterEllipsis" />
                <Separator Height="24" Margin="18,0" />
                <TextBlock
                    Width="72"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    Foreground="{DynamicResource LectureTextSecondaryBrush}"
                    Text="{Binding ElapsedText}" />
                <Separator Height="24" Margin="8,0,10,0" />
                <Button
                    x:Name="MoreButton"
                    Width="38"
                    Height="34"
                    Padding="0"
                    Click="MoreButton_Click"
                    Content="•••"
                    FontFamily="Segoe UI"
                    FontSize="14"
                    Style="{StaticResource LectureButtonStyle}"
                    ToolTip="更多课堂控制" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Background="{DynamicResource LectureSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="32,0,0,0" Orientation="Horizontal">
                <Button
                    x:Name="LiveTabButton"
                    AutomationProperties.AutomationId="LiveTranscriptTab"
                    BorderBrush="{DynamicResource LectureActionBrush}"
                    Click="WorkspaceTab_Click"
                    Content="实时字幕"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource LectureTextPrimaryBrush}"
                    Style="{StaticResource WorkspaceTabStyle}"
                    Tag="Live" />
                <Button
                    x:Name="SummaryTabButton"
                    AutomationProperties.AutomationId="LectureSummaryTab"
                    Click="WorkspaceTab_Click"
                    Content="课堂总结"
                    Style="{StaticResource WorkspaceTabStyle}"
                    Tag="Summary" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,28,0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    x:Name="LanguageText"
                    Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource LectureTextSecondaryBrush}" />
                <Button
                    AutomationProperties.AutomationId="OverlayCaptionButton"
                    Margin="0,0,10,0"
                    Click="OverlayCaption_Click"
                    Content="悬浮字幕"
                    Style="{StaticResource LectureButtonStyle}" />
                <Button
                    x:Name="PauseButton"
                    AutomationProperties.AutomationId="PauseTranslationButton"
                    Click="PauseTranslation_Click"
                    Content="暂停"
                    Style="{StaticResource LecturePrimaryButtonStyle}" />
            </StackPanel>
            <Separator VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="2" Background="{DynamicResource LectureSurfaceBrush}">
            <Grid x:Name="LivePanel" Margin="28,20,24,16">
                <controls:TranscriptTimeline x:Name="Timeline" />
            </Grid>

            <ScrollViewer
                x:Name="SummaryPanel"
                Padding="32,26"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel Width="760" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource LecturePageTitleStyle}" Text="课堂总结" />
                    <TextBlock
                        x:Name="SummaryEngineText"
                        Margin="0,8,0,0"
                        Style="{StaticResource LectureMutedTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,5,0,24"
                        Style="{StaticResource LectureMutedTextStyle}"
                        Text="总结使用独立模型，不占用实时字幕翻译配置。"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                        <Button
                            AutomationProperties.AutomationId="GenerateLectureSummaryButton"
                            Margin="0,0,10,0"
                            Click="GenerateSummary_Click"
                            Content="{Binding SummaryButtonText}"
                            IsEnabled="{Binding CanGenerateSummary}"
                            Style="{StaticResource LecturePrimaryButtonStyle}" />
                        <Button
                            Click="CopySummary_Click"
                            Content="复制总结"
                            IsEnabled="{Binding HasSummary}"
                            Style="{StaticResource LectureButtonStyle}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="12"
                        Foreground="{DynamicResource LectureTextSecondaryBrush}"
                        Text="{Binding SummaryStatus}"
                        TextWrapping="Wrap" />
                    <TextBox
                        MinHeight="300"
                        Padding="18"
                        AcceptsReturn="True"
                        Background="{DynamicResource LectureWindowBrush}"
                        BorderBrush="{DynamicResource LectureDividerBrush}"
                        BorderThickness="1"
                        FontFamily="{DynamicResource LectureUiFontFamily}"
                        FontSize="14"
                        Foreground="{DynamicResource LectureTextPrimaryBrush}"
                        IsReadOnly="True"
                        Text="{Binding SummaryText}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>

            <Popup
                x:Name="MorePopup"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=MoreButton}"
                StaysOpen="False">
                <Border
                    Width="282"
                    Margin="0,8,0,0"
                    Padding="10"
                    Background="{DynamicResource LectureSurfaceBrush}"
                    BorderBrush="{DynamicResource LectureBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Margin="10,7,10,5" Style="{StaticResource LectureSectionTitleStyle}" Text="课堂控制" />
                        <Button
                            AutomationProperties.AutomationId="OnlineCourseButton"
                            Click="OnlineCourse_Click"
                            Content="在线课程 · 电脑声音"
                            IsEnabled="{Binding CanChangeMode}"
                            Style="{StaticResource MenuButtonStyle}" />
                        <Button
                            AutomationProperties.AutomationId="ClassroomModeButton"
                            Click="ClassroomMode_Click"
                            Content="线下课堂 · 启用麦克风"
                            IsEnabled="{Binding CanChangeMode}"
                            Style="{StaticResource MenuButtonStyle}" />
                        <Button
                            AutomationProperties.AutomationId="EndLectureSessionButton"
                            Click="EndLectureSession_Click"
                            Content="结束本次课堂并保存"
                            IsEnabled="{Binding CanEndSession}"
                            Style="{StaticResource MenuButtonStyle}" />
                        <Separator Margin="8,7" />
                        <Button
                            AutomationProperties.AutomationId="ReconnectLiveCaptionsButton"
                            Click="ReconnectLiveCaptions_Click"
                            Content="重新连接系统字幕"
                            Style="{StaticResource MenuButtonStyle}" />
                        <Button Click="ReturnToLive_Click" Content="回到实时字幕" Style="{StaticResource MenuButtonStyle}" />
                        <Button Click="OpenSettings_Click" Content="翻译与模型设置" Style="{StaticResource MenuButtonStyle}" />
                        <Separator Margin="8,7" />
                        <TextBlock Margin="10,4,10,4" FontSize="11" Foreground="{DynamicResource LectureTextTertiaryBrush}" Text="更多 / 开发工具" />
                        <Button Click="OpenLegacy_Click" Content="旧版字幕视图" Style="{StaticResource MenuButtonStyle}" />
                        <Button
                            AutomationProperties.AutomationId="DemoTimelineButton"
                            Click="DemoTimeline_Click"
                            Content="{Binding DemoButtonText}"
                            IsEnabled="{Binding CanChangeMode}"
                            Style="{StaticResource MenuButtonStyle}" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid
            Grid.Row="3"
            Margin="0"
            Background="{DynamicResource LectureSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="32,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    x:Name="EngineText"
                    FontSize="11.5"
                    Foreground="{DynamicResource LectureTextSecondaryBrush}" />
                <TextBlock Margin="8,0" Foreground="{DynamicResource LectureTextTertiaryBrush}" Text="·" />
                <TextBlock
                    FontSize="11.5"
                    Foreground="{DynamicResource LectureTextSecondaryBrush}"
                    Text="{Binding CaptureMode}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,30,0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" Foreground="{DynamicResource LectureTextSecondaryBrush}" Text="✓" />
                <TextBlock
                    FontSize="11.5"
                    Foreground="{DynamicResource LectureTextSecondaryBrush}"
                    Text="{Binding SaveStatusText}" />
            </StackPanel>
            <Separator VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Page>
