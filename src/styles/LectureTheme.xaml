<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Translate Live uses fonts already installed by Windows. No font file is bundled. -->
    <FontFamily x:Key="LectureUiFontFamily">Segoe UI Variable, Microsoft YaHei UI, Segoe UI</FontFamily>
    <sys:Double x:Key="LectureSubtitleFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">20</sys:Double>
    <sys:Double x:Key="LectureSourceFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">15</sys:Double>
    <Duration x:Key="LectureMotionDuration">0:0:0.14</Duration>

    <LinearGradientBrush x:Key="LectureGlassBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFF3F5F2" />
        <GradientStop Offset="0.42" Color="#FFF7F4F5" />
        <GradientStop Offset="0.72" Color="#FFEFF5F3" />
        <GradientStop Offset="1" Color="#FFF5F2F4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LectureWindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#EFFFFFFF" />
        <GradientStop Offset="0.52" Color="#E9F8F8F6" />
        <GradientStop Offset="1" Color="#EDF7F3F5" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LectureGlassHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F7FFFFFF" />
        <GradientStop Offset="1" Color="#DFF7F8F6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LectureGlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#EFFFFFFF" />
        <GradientStop Offset="0.58" Color="#DDF8FAF8" />
        <GradientStop Offset="1" Color="#D7F3F0F3" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LectureGlassSidebarBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#DCF7F8F5" />
        <GradientStop Offset="0.64" Color="#CFEFF4F1" />
        <GradientStop Offset="1" Color="#D9F5F1F4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LectureGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#EFFFFFFF" />
        <GradientStop Offset="0.5" Color="#A8D8DAD7" />
        <GradientStop Offset="1" Color="#D6FFFFFF" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LectureAmbientMintBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#569BC9BB" />
        <GradientStop Offset="0.52" Color="#269BC9BB" />
        <GradientStop Offset="1" Color="#009BC9BB" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LectureAmbientRoseBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#4DD6B5C6" />
        <GradientStop Offset="0.52" Color="#22D6B5C6" />
        <GradientStop Offset="1" Color="#00D6B5C6" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="LectureSidebarBrush" Color="#DDF3F5F2" />
    <SolidColorBrush x:Key="LectureSurfaceBrush" Color="#E8FFFFFF" />
    <SolidColorBrush x:Key="LectureSurfaceMutedBrush" Color="#CFF3F5F2" />
    <SolidColorBrush x:Key="LectureHoverBrush" Color="#A8E4E8E4" />
    <SolidColorBrush x:Key="LecturePressedBrush" Color="#C8D9DEDA" />
    <SolidColorBrush x:Key="LectureSelectedBrush" Color="#C9E0E5E1" />
    <SolidColorBrush x:Key="LectureTextPrimaryBrush" Color="#202020" />
    <SolidColorBrush x:Key="LectureTextSecondaryBrush" Color="#666663" />
    <SolidColorBrush x:Key="LectureTextTertiaryBrush" Color="#8A8A86" />
    <SolidColorBrush x:Key="LectureDividerBrush" Color="#9ECFD3CF" />
    <SolidColorBrush x:Key="LectureBorderBrush" Color="#B8C7CBC7" />
    <SolidColorBrush x:Key="LectureActionBrush" Color="#30302F" />
    <SolidColorBrush x:Key="LectureActionHoverBrush" Color="#414140" />
    <SolidColorBrush x:Key="LectureActionTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LectureSuccessBrush" Color="#397158" />
    <SolidColorBrush x:Key="LectureWarningBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="LectureErrorBrush" Color="#B42318" />

    <Style x:Key="LectureGlassHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LectureGlassHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LectureGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" Color="#38474A47" Direction="270" Opacity="0.13" ShadowDepth="5" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LectureGlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LectureGlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LectureGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" Color="#33474A47" Direction="270" Opacity="0.12" ShadowDepth="7" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LectureGlassSidebarStyle" TargetType="Border" BasedOn="{StaticResource LectureGlassPanelStyle}">
        <Setter Property="Background" Value="{DynamicResource LectureGlassSidebarBrush}" />
    </Style>

    <!-- Override WPF-UI's colored accent with the same neutral hierarchy. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F7F7F5" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#202020" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#666663" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A8A86" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#30302F" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#414140" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#50504F" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#30302F" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E9E9E6" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#CECECA" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DADAD7" />

    <Style x:Key="LecturePageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource LectureUiFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource LectureTextPrimaryBrush}" />
    </Style>

    <Style x:Key="LectureSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource LectureUiFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource LectureTextPrimaryBrush}" />
    </Style>

    <Style x:Key="LectureMutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource LectureUiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource LectureTextSecondaryBrush}" />
    </Style>

    <Style x:Key="LectureButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Background" Value="{DynamicResource LectureSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LectureTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LectureBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource LectureUiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="9"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LectureHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LecturePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LecturePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LectureButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource LectureActionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LectureActionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LectureActionTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="9">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LectureActionHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LectureActionHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LectureNavButtonStyle" TargetType="Button" BasedOn="{StaticResource LectureButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="LectureFieldStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{DynamicResource LectureUiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource LectureTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource LectureSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LectureBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource LectureDividerBrush}" />
        <Setter Property="Margin" Value="0" />
    </Style>
</ResourceDictionary>
