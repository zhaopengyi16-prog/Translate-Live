<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Translate Live"
    Width="1440"
    Height="900"
    MinWidth="980"
    MinHeight="640"
    Background="{DynamicResource LectureGlassBackdropBrush}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource LectureUiFontFamily}"
    Foreground="{DynamicResource LectureTextPrimaryBrush}"
    LocationChanged="MainWindow_LocationChanged"
    ResizeMode="CanResize"
    SizeChanged="MainWindow_SizeChanged"
    Topmost="False"
    UseLayoutRounding="True"
    WindowBackdropType="None"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid x:Name="MainContent" Background="{DynamicResource LectureGlassBackdropBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Canvas
            Grid.RowSpan="2"
            Panel.ZIndex="0"
            IsHitTestVisible="False">
            <Ellipse
                Canvas.Left="-210"
                Canvas.Top="-220"
                Width="760"
                Height="620"
                Fill="{DynamicResource LectureAmbientMintBrush}" />
            <Ellipse
                Canvas.Right="-180"
                Canvas.Top="80"
                Width="720"
                Height="640"
                Fill="{DynamicResource LectureAmbientRoseBrush}" />
            <Ellipse
                Canvas.Left="510"
                Canvas.Bottom="-370"
                Width="760"
                Height="620"
                Fill="{DynamicResource LectureAmbientMintBrush}"
                Opacity="0.62" />
        </Canvas>

        <Border
            Grid.Row="0"
            Margin="12,10,12,0"
            Panel.ZIndex="1"
            Style="{StaticResource LectureGlassHeaderStyle}">
            <ui:TitleBar
                Height="54"
                Background="Transparent"
                Foreground="{DynamicResource LectureTextPrimaryBrush}"
                ShowMaximize="True">
                <ui:TitleBar.Header>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Width="32"
                            Height="32"
                            Margin="0,0,11,0"
                            Background="#DFFFFFFF"
                            BorderBrush="#EFFFFFFF"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="9">
                            <Grid Margin="2">
                                <Border Background="#FF2D2D2F" CornerRadius="7" />
                                <Ellipse
                                    Width="11"
                                    Height="11"
                                    Margin="0,0,13,13"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Fill="#FFDCE9E4" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI Variable Display, Segoe UI"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="TL" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Translate Live" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="10.5"
                                Foreground="{DynamicResource LectureTextTertiaryBrush}"
                                Text="Live captions · Translation · Review" />
                        </StackPanel>
                    </StackPanel>
                </ui:TitleBar.Header>
                <ui:TitleBar.TrailingContent>
                    <StackPanel Margin="0,0,6,0" Orientation="Horizontal">
                        <ui:Button
                            x:Name="CaptionLogButton"
                            Margin="0,0,4,0"
                            Appearance="Transparent"
                            Click="CaptionLogButton_Click"
                            Foreground="{DynamicResource LectureTextPrimaryBrush}"
                            Icon="{ui:SymbolIcon History16, Filled=False}"
                            ToolTip="旧版字幕记录"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="LogOnlyButton"
                            Appearance="Transparent"
                            Click="LogOnlyButton_Click"
                            Foreground="{DynamicResource LectureTextPrimaryBrush}"
                            Icon="{ui:SymbolIcon Pause16, Filled=False}"
                            ToolTip="暂停翻译"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="OverlayModeButton"
                            Appearance="Transparent"
                            Click="OverlayModeButton_Click"
                            Foreground="{DynamicResource LectureTextPrimaryBrush}"
                            Icon="{ui:SymbolIcon ClosedCaptionOff24, Filled=False}"
                            ToolTip="悬浮字幕"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="TopmostButton"
                            Margin="0,0,5,0"
                            Appearance="Transparent"
                            Click="TopmostButton_Click"
                            Foreground="{DynamicResource LectureTextPrimaryBrush}"
                            Icon="{ui:SymbolIcon Pin16, Filled=False}"
                            ToolTip="窗口置顶" />
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="12,10,12,12"
            Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Style="{StaticResource LectureGlassSidebarStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="22,18,16,10">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="工作区" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource LectureTextTertiaryBrush}"
                            Text="字幕、总结与课堂记录" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button
                            x:Name="WorkspaceNavButton"
                            AutomationProperties.AutomationId="WorkspaceNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource LectureNavButtonStyle}"
                            Tag="{x:Type local:LectureWorkspacePage}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Width="20" Margin="0,0,12,0" Symbol="Home24" />
                                <TextBlock VerticalAlignment="Center" Text="课堂工作台" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="HistoryNavButton"
                            AutomationProperties.AutomationId="HistoryNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource LectureNavButtonStyle}"
                            Tag="{x:Type local:HistoryPage}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Width="20" Margin="0,0,12,0" Symbol="History24" />
                                <TextBlock VerticalAlignment="Center" Text="课堂回顾" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="22,22,16,8">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource LectureTextTertiaryBrush}"
                            Text="最近课堂" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="3"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RecentSessionsPanel" Margin="0,0,0,12">
                            <TextBlock
                                Margin="22,8"
                                FontSize="12"
                                Foreground="{DynamicResource LectureTextTertiaryBrush}"
                                Text="正在载入…" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Margin="0,0,0,12">
                        <Separator Margin="18,0,18,10" />
                        <Button
                            x:Name="SettingsNavButton"
                            AutomationProperties.AutomationId="SettingsNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource LectureNavButtonStyle}"
                            Tag="{x:Type local:SettingPage}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Width="20" Margin="0,0,12,0" Symbol="Settings24" />
                                <TextBlock VerticalAlignment="Center" Text="设置" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="InfoNavButton"
                            AutomationProperties.AutomationId="InfoNavButton"
                            Click="NavButton_Click"
                            Style="{StaticResource LectureNavButtonStyle}"
                            Tag="{x:Type local:InfoPage}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Width="20" Margin="0,0,12,0" Symbol="Info24" />
                                <TextBlock VerticalAlignment="Center" Text="关于" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                ClipToBounds="True"
                Style="{StaticResource LectureGlassPanelStyle}">
                <Grid Background="Transparent">
                    <Frame
                        x:Name="ContentFrame"
                        Background="Transparent"
                        JournalOwnership="OwnsJournal"
                        NavigationUIVisibility="Hidden" />
                    <ui:SnackbarPresenter
                        x:Name="snackbarHost"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </Grid>

        <ContentPresenter
            x:Name="DialogHostContainer"
            Grid.RowSpan="2"
            MinHeight="167"
            Panel.ZIndex="20"
            Visibility="Collapsed" />
    </Grid>
</ui:FluentWindow>
