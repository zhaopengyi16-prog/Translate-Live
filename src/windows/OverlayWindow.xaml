<Window
    x:Class="LiveCaptionsTranslator.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Translate Live 悬浮字幕"
    Width="700"
    Height="156"
    MinWidth="650"
    MinHeight="140"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{DynamicResource LectureUiFontFamily}"
    MouseEnter="Window_MouseEnter"
    MouseLeave="Window_MouseLeave"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="TransparentThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style x:Key="OverlayControlStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="#760E1011" />
            <Setter Property="Foreground" Value="#F7F7F8" />
            <Setter Property="BorderBrush" Value="#42FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Border
                                    Height="1"
                                    Margin="6,0"
                                    VerticalAlignment="Top"
                                    Background="#6AFFFFFF"
                                    CornerRadius="1"
                                    IsHitTestVisible="False" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#8A17191B" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#72FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#A6222426" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A8FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource LectureUiFontFamily}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="16,16,16,8"
            Background="#70000000"
            CornerRadius="24"
            IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="30"
                    Direction="270"
                    Opacity="0.42"
                    ShadowDepth="9"
                    Color="#160F22" />
            </Border.Effect>
        </Border>

        <Border
            x:Name="BorderBackground"
            Grid.Row="0"
            Margin="16,16,16,8"
            Background="Transparent"
            BorderBrush="#86FFFFFF"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="24"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="GlassTintLayer"
                    Grid.RowSpan="2"
                    Background="#A6202020"
                    CornerRadius="23"
                    IsHitTestVisible="False" />

                <Border Grid.RowSpan="2" CornerRadius="23" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#72FFFFFF" />
                            <GradientStop Offset="0.28" Color="#20FFFFFF" />
                            <GradientStop Offset="0.68" Color="#1200D7FF" />
                            <GradientStop Offset="1" Color="#20FF94C5" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border
                    Grid.RowSpan="2"
                    Margin="1"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1,1,0,0"
                    CornerRadius="23"
                    IsHitTestVisible="False" />

                <Border
                    Grid.RowSpan="2"
                    Width="42"
                    Height="4"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#62FFFFFF"
                    CornerRadius="2"
                    IsHitTestVisible="False" />

                <Border x:Name="TranslatedCaptionCard" Grid.Row="0" Margin="18,12,18,2" Padding="8,5">
                    <local:StrokeDecorator x:Name="TranslatedCaptionDecorator" Stroke="Black" StrokeThickness="0">
                        <TextBlock x:Name="TranslatedCaption" FontSize="18" Style="{StaticResource CaptionBlockStyle}">
                            <Run x:Name="NoticePrefixRun" FontFamily="Cascadia Mono, Consolas" Text="{Binding OverlayNoticePrefix, UpdateSourceTrigger=PropertyChanged}" />
                            <Run x:Name="PreviousTranslationRun" Text="{Binding OverlayPreviousTranslation, Mode=OneWay}" />
                            <Run x:Name="CurrentTranslationRun" Text="{Binding OverlayCurrentTranslation, UpdateSourceTrigger=PropertyChanged}" />
                        </TextBlock>
                    </local:StrokeDecorator>
                </Border>

                <Border x:Name="OriginalCaptionCard" Grid.Row="1" Margin="18,0,18,12" Padding="8,4">
                    <local:StrokeDecorator x:Name="OriginalCaptionDecorator" Stroke="Black" StrokeThickness="0">
                        <TextBlock
                            x:Name="OriginalCaption"
                            FontSize="14"
                            Opacity="0.74"
                            Style="{StaticResource CaptionBlockStyle}"
                            Text="{Binding OverlayOriginalCaption, UpdateSourceTrigger=PropertyChanged}" />
                    </local:StrokeDecorator>
                </Border>

                <Border
                    x:Name="EmptyStatePanel"
                    Grid.RowSpan="2"
                    Margin="24"
                    Padding="14,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#28FFFFFF"
                    BorderBrush="#45FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    IsHitTestVisible="False"
                    Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,9,0"
                            VerticalAlignment="Center"
                            Fill="#D8FFFFFF" />
                        <TextBlock
                            x:Name="EmptyStateText"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI, Microsoft YaHei UI"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#F5FFFFFF"
                            Text="等待字幕" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI, Microsoft YaHei UI"
                            FontSize="12"
                            Foreground="#AFFFFFFF"
                            Text="可拖动窗口" />
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <Border
            x:Name="ControlPanel"
            Grid.Row="1"
            Margin="16,0,16,16"
            Padding="5"
            HorizontalAlignment="Center"
            BorderBrush="#86FFFFFF"
            BorderThickness="1"
            ClipToBounds="False"
            CornerRadius="18"
            Opacity="0"
            Panel.ZIndex="30"
            RenderTransformOrigin="0.5,0"
            Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="24"
                    Direction="270"
                    Opacity="0.38"
                    ShadowDepth="7"
                    Color="#160F22" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="4" />
            </Border.RenderTransform>
            <Grid>
                <Border
                    x:Name="ControlPanelTintLayer"
                    Background="#A6202020"
                    CornerRadius="17"
                    IsHitTestVisible="False" />
                <Border CornerRadius="17" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#72FFFFFF" />
                            <GradientStop Offset="0.28" Color="#20FFFFFF" />
                            <GradientStop Offset="0.68" Color="#1200D7FF" />
                            <GradientStop Offset="1" Color="#20FF94C5" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border
                    Margin="1"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1,1,0,0"
                    CornerRadius="16"
                    IsHitTestVisible="False" />
                <StackPanel Margin="1" Orientation="Horizontal">
                    <Button x:Name="FontSizeIncrease" Click="FontIncrease_Click" Content="A+" Style="{StaticResource OverlayControlStyle}" ToolTip="增大字幕字号" />
                    <Button x:Name="FontSizeDecrease" Click="FontDecrease_Click" Content="A−" Style="{StaticResource OverlayControlStyle}" ToolTip="减小字幕字号" />
                    <Button x:Name="FontStrokeIncrease" Click="FontStrokeIncrease_Click" Content="描+" Style="{StaticResource OverlayControlStyle}" ToolTip="增加字幕描边" />
                    <Button x:Name="FontStrokeDecrease" Click="FontStrokeDecrease_Click" Content="描−" Style="{StaticResource OverlayControlStyle}" ToolTip="减少字幕描边" />
                    <Button x:Name="FontBold" Click="FontBold_Click" Content="粗体" Style="{StaticResource OverlayControlStyle}" ToolTip="切换原文和译文粗体" />
                    <Button x:Name="FontColorCycle" Click="FontColorCycle_Click" Content="字色" Style="{StaticResource OverlayControlStyle}" ToolTip="切换字幕颜色" />
                    <Border Width="1" Margin="5,6" Background="#42FFFFFF" />
                    <Button x:Name="OpacityIncrease" Click="BackgroundOpacityIncrease_Click" Content="底+" Style="{StaticResource OverlayControlStyle}" ToolTip="增加背景不透明度" />
                    <Button x:Name="OpacityDecrease" Click="BackgroundOpacityDecrease_Click" Content="底−" Style="{StaticResource OverlayControlStyle}" ToolTip="降低背景不透明度" />
                    <Button x:Name="BackgroundColorCycle" Click="BackgroundColorCycle_Click" Content="底色" Style="{StaticResource OverlayControlStyle}" ToolTip="切换背景颜色" />
                    <Border Width="1" Margin="5,6" Background="#42FFFFFF" />
                    <Button x:Name="OnlyModeButton" Click="OnlyModeButton_Click" Content="双语" Style="{StaticResource OverlayControlStyle}" ToolTip="当前显示：双语；点击切换" />
                    <Button x:Name="SwitchModeButton" Click="SwitchModeButton_Click" Content="交换" Style="{StaticResource OverlayControlStyle}" ToolTip="交换原文与译文位置" />
                    <Button x:Name="ClickThrough" Click="ClickThrough_Click" Content="穿透" Style="{StaticResource OverlayControlStyle}" ToolTip="开启点击穿透；可从主窗口关闭悬浮字幕" />
                </StackPanel>
            </Grid>
        </Border>

        <Thumb x:Name="TopThumb" Grid.RowSpan="2" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Top" Cursor="SizeNS" DragDelta="TopThumb_OnDragDelta" Style="{StaticResource TransparentThumbStyle}" />
        <Thumb x:Name="BottomThumb" Grid.RowSpan="2" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Cursor="SizeNS" DragDelta="BottomThumb_OnDragDelta" Style="{StaticResource TransparentThumbStyle}" />
        <Thumb x:Name="LeftThumb" Grid.RowSpan="2" Width="12" HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="SizeWE" DragDelta="LeftThumb_OnDragDelta" Style="{StaticResource TransparentThumbStyle}" />
        <Thumb x:Name="RightThumb" Grid.RowSpan="2" Width="12" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE" DragDelta="RightThumb_OnDragDelta" Style="{StaticResource TransparentThumbStyle}" />
        <Thumb x:Name="TopLeftThumb" Grid.RowSpan="2" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="TopLeftThumb_OnDragDelta" Style="{StaticResource TransparentThumbStyle}" />
        <Thumb x:Name="TopRightThumb" Grid.RowSpan="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="TopRightThumb_OnDragDelta" Style="{StaticResource TransparentThumbStyle}" />
        <Thumb x:Name="BottomLeftThumb" Grid.RowSpan="2" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="BottomLeftThumb_OnDragDelta" Style="{StaticResource TransparentThumbStyle}" />
        <Thumb x:Name="BottomRightThumb" Grid.RowSpan="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="BottomRightThumb_OnDragDelta" Style="{StaticResource TransparentThumbStyle}" />
    </Grid>
</Window>
