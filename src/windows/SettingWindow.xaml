<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.SettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:LiveCaptionsTranslator.controls"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="设置"
    Width="980"
    Height="720"
    MinWidth="820"
    MinHeight="560"
    Background="{DynamicResource LectureWindowBrush}"
    FontFamily="{DynamicResource LectureUiFontFamily}"
    Foreground="{DynamicResource LectureTextPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Topmost="False"
    WindowBackdropType="None"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Height="46"
            Background="{DynamicResource LectureSurfaceBrush}"
            Foreground="{DynamicResource LectureTextPrimaryBrush}"
            ShowMaximize="False">
            <ui:TitleBar.Header>
                <TextBlock Padding="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold">Translate Live 设置</TextBlock>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource LectureSidebarBrush}" BorderBrush="{DynamicResource LectureDividerBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="200">
                        <ui:Button
                            x:Name="AppearanceButton"
                            Margin="10,10,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Appearance">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0" Symbol="Settings24" />
                                <ui:TextBlock VerticalAlignment="Center" Text="外观与字体" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="PromptButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Prompt">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0" Symbol="DocumentCatchUp16" />
                                <ui:TextBlock VerticalAlignment="Center" Text="Prompt" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="SummaryButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Summary">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0" Symbol="TextBulletListSquare24" />
                                <ui:TextBlock VerticalAlignment="Center" Text="Summary" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="OllamaButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Ollama">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="Ollama" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="OpenAIButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="OpenAI">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="OpenAI" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="OpenRouterButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="OpenRouter">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="OpenRouter" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="DeepLButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="DeepL">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="DeepL" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="YoudaoButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Youdao">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="Youdao" />
                            </StackPanel>
                        </ui:Button>


                        <ui:Button
                            x:Name="MTranServerButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="MTranServer">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="MTranServer" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="BaiduButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Baidu">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="Baidu" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="LibreTranslateButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="LibreTranslate">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="LibreTranslate" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="1"
                Background="{DynamicResource LectureWindowBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Card Grid.Row="0" Margin="20,14,20,4" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock
                                    x:Name="CredentialTargetText"
                                    FontWeight="SemiBold"
                                    Text="凭据安全 · 请选择服务" />
                                <ui:TextBlock
                                    x:Name="CredentialActionStatus"
                                    Margin="0,3,8,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="API 凭据默认隐藏，并保存到 Windows DPAPI。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <ui:ToggleSwitch
                                    x:Name="RevealCredentialsToggle"
                                    Width="82"
                                    Margin="0,0,8,0"
                                    OffContent="隐藏"
                                    OnContent="显示" />
                                <ui:Button
                                    x:Name="TestCredentialButton"
                                    Margin="0,0,8,0"
                                    Click="TestCredential_Click"
                                    Content="测试连接"
                                    IsEnabled="False" />
                                <ui:Button
                                    x:Name="ClearCredentialButton"
                                    Click="ClearCredential_Click"
                                    Content="清除并重录"
                                    IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ScrollViewer
                        x:Name="ContentScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="ContentPanel" Margin="28,22,28,36">
                        <ui:TextBlock
                            Margin="0,0,0,10"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="设置" />

                        <StackPanel x:Name="AllSettings" Margin="5">
                            <StackPanel x:Name="AppearanceSection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="外观与字体" />
                                <Border
                                    Padding="22"
                                    Background="{DynamicResource LectureSurfaceBrush}"
                                    BorderBrush="{DynamicResource LectureDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <ui:TextBlock
                                            Margin="0,0,0,16"
                                            Foreground="{DynamicResource LectureTextSecondaryBrush}"
                                            Text="只使用本机已安装字体。应用不会下载、复制或打包 Apple 字体；中文始终保留 Microsoft YaHei UI 回退。"
                                            TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock Margin="0,0,0,6" Text="搜索本机字体" />
                                                <TextBox
                                                    x:Name="FontSearchBox"
                                                    AutomationProperties.AutomationId="FontSearchBox"
                                                    Height="36"
                                                    Style="{StaticResource LectureFieldStyle}"
                                                    TextChanged="FontSearchBox_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <ui:TextBlock Margin="0,0,0,6" Text="全局界面字体" />
                                                <ComboBox
                                                    x:Name="UiFontFamilyBox"
                                                    AutomationProperties.AutomationId="UiFontFamilyBox"
                                                    Height="36"
                                                    DisplayMemberPath="DisplayName"
                                                    SelectionChanged="UiFontFamilyBox_SelectionChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock Margin="0,0,0,6" Text="字幕字号" />
                                                <ui:NumberBox
                                                    x:Name="SubtitleFontSizeBox"
                                                    AutomationProperties.AutomationId="SubtitleFontSizeBox"
                                                    Height="36"
                                                    AcceptsExpression="False"
                                                    ClearButtonEnabled="False"
                                                    Maximum="32"
                                                    Minimum="14"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding Appearance.SubtitleFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <ui:TextBlock Margin="0,0,0,6" Text="动态效果" />
                                                <ui:ToggleSwitch
                                                    x:Name="ReduceMotionToggle"
                                                    AutomationProperties.AutomationId="ReduceMotionToggle"
                                                    IsChecked="{Binding Appearance.ReduceMotion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    OffContent="标准"
                                                    OnContent="减少动态" />
                                            </StackPanel>
                                        </Grid>

                                        <Border
                                            Margin="0,22,0,0"
                                            Padding="18"
                                            Background="{DynamicResource LectureWindowBrush}"
                                            BorderBrush="{DynamicResource LectureDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock
                                                    FontFamily="{DynamicResource LectureUiFontFamily}"
                                                    FontSize="{DynamicResource LectureSourceFontSize}"
                                                    Foreground="{DynamicResource LectureTextSecondaryBrush}"
                                                    Text="A clear interface should stay out of the way." />
                                                <TextBlock
                                                    Margin="0,7,0,0"
                                                    FontFamily="{DynamicResource LectureUiFontFamily}"
                                                    FontSize="{DynamicResource LectureSubtitleFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource LectureTextPrimaryBrush}"
                                                    Text="清晰的界面应该让内容成为主角。" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="FontSupportText"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource LectureTextSecondaryBrush}"
                                                Text="字体状态" />
                                            <Button
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Click="ResetAppearance_Click"
                                                Content="恢复默认"
                                                Style="{StaticResource LectureButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PromptSection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="Medium"
                                    Text="Prompt" />
                                <ui:Card Padding="15">
                                    <StackPanel Margin="15,0,15,0" Orientation="Vertical">
                                        <ui:TextBlock Margin="2.5,0,0,5" TextWrapping="Wrap">
                                            <Run FontWeight="Bold" Text="Note 1:" />
                                            <Run Text="The {0} in the prompt indicates the target language, so make sure your prompt includes {0}." />
                                            <Run FontWeight="Bold" Text="&#x0A;Note 2:" />
                                            <Run Text="The source text is enclosed with 🔤." />
                                        </ui:TextBlock>
                                        <ui:TextBox
                                            x:Name="PromptTextBox"
                                            AcceptsReturn="True"
                                            ClearButtonEnabled="False"
                                            Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>

                            <StackPanel x:Name="SummarySection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="Medium"
                                    Text="Class Summary" />
                                <ui:Card Padding="15">
                                    <StackPanel Margin="15,0,15,0">
                                        <ui:TextBlock Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Independent OpenAI-compatible model for long-form lecture summaries." TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,10">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Model Name" />
                                                <ui:TextBox Width="180" Height="30" Padding="10,4,10,7" Text="{Binding Summary.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,10">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Temperature" />
                                                <ui:NumberBox Width="180" Height="30" Padding="10,4,10,7" Minimum="0" Maximum="2" SmallChange="0.1" Value="{Binding Summary.Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="API Url" />
                                                <ui:TextBox Width="260" Height="30" Padding="10,4,10,7" Text="{Binding Summary.ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="API Key" />
                                                <controls:CredentialBox
                                                    x:Name="SummaryCredential"
                                                    Width="260"
                                                    Height="30"
                                                    FontSize="13.3"
                                                    IsRevealed="{Binding IsChecked, ElementName=RevealCredentialsToggle}"
                                                    Value="{Binding Summary.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <ui:TextBlock Margin="2.5,4,0,5" Text="Summary Prompt" />
                                        <ui:TextBox MinHeight="100" AcceptsReturn="True" ClearButtonEnabled="False" Text="{Binding Summary.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>

                            <StackPanel x:Name="OllamaSection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="Medium"
                                    Text="Ollama" />
                                <ui:Card Padding="15">
                                    <StackPanel>
                                        <Grid Margin="15,0,15,10">
                                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Text="Current Config: " />
                                                <ui:Button
                                                    Margin="0,0,10,0"
                                                    Padding="8,4,8,4"
                                                    Click="PriorButton_Click"
                                                    Icon="{ui:SymbolIcon chevronLeft12}"
                                                    Tag="Ollama" />
                                                <ui:TextBlock
                                                    x:Name="OllamaIndex"
                                                    VerticalAlignment="Center"
                                                    Text="1/1" />
                                                <ui:Button
                                                    Margin="10,0,0,0"
                                                    Padding="8,4,8,4"
                                                    Click="NextButton_Click"
                                                    Icon="{ui:SymbolIcon chevronRight12}"
                                                    Tag="Ollama" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <ui:Button
                                                    Margin="0,0,10,0"
                                                    Click="NewButton_Click"
                                                    Content="New"
                                                    Tag="Ollama" />
                                                <ui:Button
                                                    Margin="0,0,-10,0"
                                                    Click="DeleteButton_Click"
                                                    Content="Delete"
                                                    Tag="Ollama" />
                                                <ui:Flyout x:Name="OllamaDeleteFlyout">
                                                    <TextBlock
                                                        Width="120"
                                                        Text="You must keep at least one config."
                                                        TextWrapping="Wrap" />
                                                </ui:Flyout>
                                            </StackPanel>
                                        </Grid>
                                        <Separator Margin="0,0,0,10" />
                                        <Grid x:Name="OllamaGrid">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Model Name" />
                                                <ui:TextBox
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    Text="{Binding [Ollama].ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="15,10,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Temperature" />
                                                <ui:NumberBox
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    ClearButtonEnabled="False"
                                                    FontSize="13.3"
                                                    LargeChange="1"
                                                    Maximum="2"
                                                    Minimum="0"
                                                    SmallChange="0.1"
                                                    Value="{Binding [Ollama].Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <ui:TextBlock Margin="2.5,0,0,5" Text="API Url" />
                                                    <ui:Flyout x:Name="OllamaAPIUrlInfoFlyout">
                                                        <ui:TextBlock Width="170" TextWrapping="Wrap">
                                                            <Run Text="No need to explicitly add" />
                                                            <Run FontWeight="Bold" Text="`api/chat`" />
                                                            <Run Text="suffix." />
                                                        </ui:TextBlock>
                                                    </ui:Flyout>
                                                    <Button
                                                        Width="15"
                                                        Height="15"
                                                        Margin="-5,-3,0,0"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        MouseEnter="OllamaAPIUrlInfo_MouseEnter"
                                                        MouseLeave="OllamaAPIUrlInfo_MouseLeave">
                                                        <ui:SymbolIcon Symbol="Info16" />
                                                    </Button>
                                                </StackPanel>

                                                <ui:TextBox
                                                    Width="200"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    Text="{Binding [Ollama].ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>

                            <StackPanel x:Name="OpenAISection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="Medium"
                                    Text="OpenAI" />

                                <ui:Card Padding="15">
                                    <StackPanel>
                                        <Grid Margin="15,0,15,10">
                                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Text="Current Config: " />
                                                <ui:Button
                                                    Margin="0,0,10,0"
                                                    Padding="8,4,8,4"
                                                    Click="PriorButton_Click"
                                                    Icon="{ui:SymbolIcon chevronLeft12}"
                                                    Tag="OpenAI" />
                                                <ui:TextBlock
                                                    x:Name="OpenAIIndex"
                                                    VerticalAlignment="Center"
                                                    Text="1/1" />
                                                <ui:Button
                                                    Margin="10,0,0,0"
                                                    Padding="8,4,8,4"
                                                    Click="NextButton_Click"
                                                    Icon="{ui:SymbolIcon chevronRight12}"
                                                    Tag="OpenAI" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <ui:Button
                                                    Margin="0,0,10,0"
                                                    Click="NewButton_Click"
                                                    Content="New"
                                                    Tag="OpenAI" />
                                                <ui:Button
                                                    Margin="0,0,-10,0"
                                                    Click="DeleteButton_Click"
                                                    Content="Delete"
                                                    Tag="OpenAI" />
                                                <ui:Flyout x:Name="OpenAIDeleteFlyout">
                                                    <TextBlock
                                                        Width="120"
                                                        Text="You must keep at least one config."
                                                        TextWrapping="Wrap" />
                                                </ui:Flyout>
                                            </StackPanel>
                                        </Grid>
                                        <Separator Margin="0,0,0,10" />
                                        <Grid x:Name="OpenAIGrid">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Model Name" />
                                                <ui:TextBox
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    Text="{Binding [OpenAI].ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
