<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="开始使用 Translate Live"
    Width="720"
    Height="560"
    Background="{DynamicResource LectureWindowBrush}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource LectureUiFontFamily}"
    Foreground="{DynamicResource LectureTextPrimaryBrush}"
    ResizeMode="NoResize"
    WindowBackdropType="None"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Height="46"
            Background="{DynamicResource LectureSurfaceBrush}"
            Foreground="{DynamicResource LectureTextPrimaryBrush}"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Header>
                <TextBlock Padding="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="首次使用" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="36,30,36,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource LecturePageTitleStyle}" Text="欢迎使用 Translate Live" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="13.5"
                    Foreground="{DynamicResource LectureTextSecondaryBrush}"
                    Text="开始实时翻译前，请先完成 Windows 实时字幕的一次性准备。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,24,0,20">
                <Border Padding="18" Background="{DynamicResource LectureSurfaceBrush}" BorderBrush="{DynamicResource LectureDividerBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="1  准备 Windows 实时字幕" />
                        <TextBlock Margin="24,7,0,0" Foreground="{DynamicResource LectureTextSecondaryBrush}" Text="打开 Windows 实时字幕，按系统引导下载所需的本地语音识别和语言文件。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="0,10,0,0" Padding="18" Background="{DynamicResource LectureSurfaceBrush}" BorderBrush="{DynamicResource LectureDividerBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="2  选择正确位置" />
                        <TextBlock Margin="24,7,0,0" Foreground="{DynamicResource LectureTextSecondaryBrush}" Text="在系统字幕的齿轮菜单中选择“位置 → 覆盖在屏幕上”，再回到 Translate Live。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="0,10,0,0" Padding="18" Background="{DynamicResource LectureSurfaceBrush}" BorderBrush="{DynamicResource LectureDividerBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="3  选择课程音源" />
                        <TextBlock Margin="24,7,0,0" Foreground="{DynamicResource LectureTextSecondaryBrush}" Text="在线课程使用电脑声音；线下课堂只会在你明确点击后启用本次麦克风。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource LectureTextSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="更多系统配置说明请查看上游 " />
                    <Hyperlink NavigateUri="https://github.com/SakiRinn/LiveCaptions-Translator/wiki" RequestNavigate="Hyperlink_RequestNavigate">Wiki</Hyperlink>
                    <Run Text="。源语言需在 Windows 实时字幕中修改。" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Padding="22,8"
                    Click="CloseButton_Click"
                    Content="我已完成准备"
                    Style="{StaticResource LecturePrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
